{
  "name": "nisan-sinai-tech",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "build": "npm run build:sites",
    "build:sites": "bash scripts/build-verified.sh",
    "build:vercel": "next build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "start:vercel": "next start",
    "test": "npm run test:unit",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:rendered": "node --test tests/rendered-html.test.mjs",
    "test:migrations": "bash scripts/test-migrations.sh",
    "test:audit-policy": "node --test tests/audit-policy.test.mjs",
    "scan:secrets": "bash scripts/scan-secrets.sh",
    "smoke": "bash scripts/smoke.sh",
    "build:og": "node scripts/build-og-images.mjs",
    "capture:projects": "node scripts/capture-project-shots.mjs",
    "check:data-api": "bash scripts/check-data-api.sh",
    "type-check": "tsc --noEmit",
    "audit:prod": "npm audit --omit=dev --audit-level=moderate",
    "audit:ci": "node scripts/audit-policy.mjs --allow-braces-dev-until-2026-11-04",
    "qa": "npm run scan:secrets && npm run audit:ci && npm run lint && npm run type-check && npm run test:audit-policy && npm run test:coverage && npm run build:vercel && npm run build:sites && npm run test:rendered && npm run test:e2e",
    "validate:artifact": "bash scripts/validate-artifact.sh",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "bash scripts/sites-env.sh -- drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4",
    "geist": "1.8.1",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.63.2",
    "@cloudflare/workers-types": "5.20261013.1",
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitejs/plugin-rsc": "0.5.37",
    "@vitest/coverage-v8": "4.1.12",
    "axe-core": "4.14.0",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "react-server-dom-webpack": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vinext": "0.2.1",
    "vite": "8.3.4",
    "vitest": "4.1.12",
    "wrangler": "4.150.0"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    },
    "baseline-browser-mapping": "2.11.28",
    "browserslist": "4.29.3",
    "fast-uri": "3.1.8",
    "image-size": "2.0.4",
    "sharp": "0.35.5",
    "source-map-js": "1.2.2"
  },
  "type": "module",
  "displayName": "ניסן סיני טכנולוגיות"
}
