{
  "name": "nisan-sinai-tech",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "build": "npm run build:sites",
    "build:sites": "bash scripts/build-verified.sh",
    "build:vercel": "next build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "start:vercel": "next start",
    "test": "npm run test:unit",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:rendered": "node --test tests/rendered-html.test.mjs",
    "test:migrations": "bash scripts/test-migrations.sh",
    "scan:secrets": "bash scripts/scan-secrets.sh",
    "smoke": "bash scripts/smoke.sh",
    "build:og": "node scripts/build-og-images.mjs",
    "capture:projects": "node scripts/capture-project-shots.mjs",
    "check:data-api": "bash scripts/check-data-api.sh",
    "type-check": "tsc --noEmit",
    "audit:prod": "npm audit --omit=dev --audit-level=moderate",
    "qa": "npm run scan:secrets && npm run audit:prod && npm run lint && npm run type-check && npm run test:coverage && npm run build:vercel && npm run build:sites && npm run test:rendered && npm run test:e2e",
    "validate:artifact": "bash scripts/validate-artifact.sh",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "bash scripts/sites-env.sh -- drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "geist": "1.7.2",
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.53.1",
    "@cloudflare/workers-types": "5.20260822.1",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.1.0",
    "@vitejs/plugin-rsc": "0.5.34",
    "@vitest/coverage-v8": "4.1.11",
    "axe-core": "4.13.0",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.2",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vinext": "0.2.1",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "wrangler": "4.125.0"
  },
  "type": "module",
  "displayName": "ניסן סיני טכנולוגיות"
}
